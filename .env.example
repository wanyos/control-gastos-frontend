# Environment variables template (committed, no secrets).
# Copy to `.env.development.local` for personal overrides (git-ignored via *.local).
# Only variables prefixed with VITE_ are exposed to the client (import.meta.env).

# Base URL of the backend API (required). Two accepted forms:
#   /                      root-relative: resolved against the page origin, so the
#                          request is same-origin and the Vite proxy forwards /api
#                          to the backend (this is what .env.development uses).
#   http://localhost:3000  absolute: the browser calls that origin directly, which
#                          needs CORS on the backend.
VITE_API_URL=/
